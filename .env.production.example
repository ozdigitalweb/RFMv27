# ---------- BANCO DE DADOS (OBRIGATÓRIO) ----------
# Opção 1: Connection string completa (recomendado)
DATABASE_URL="postgresql://usuario:senha@host:5432/rebeldiafm?sslmode=require"

# Opção 2: Componentes separados (se preferir)
# SQL_HOST=seu-host.postgres.database.azure.com
# SQL_PORT=5432
# SQL_USER=usuario
# SQL_PASSWORD=senha-forte-aqui
# SQL_DB_NAME=rebeldiafm

# ---------- APLICAÇÃO ----------
NODE_ENV=production
PORT=3000
APP_URL="https://seudominio.com.br"

# ---------- ADMIN (OBRIGATÓRIO - troque!) ----------
