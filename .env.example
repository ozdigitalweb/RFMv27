# PORT: Server listening port (defaults to 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (or use SQL_HOST / SQL_USER / SQL_PASSWORD / SQL_DB_NAME)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable"

# Admin panel credentials (configured via environment secrets, never hardcoded in production)
ADMIN_USER="admin@rebeldiafm.com.br"
ADMIN_PASSWORD="MY_ADMIN_PASSWORD"

# SESSION_SECRET: HMAC signing secret for host session tokens
SESSION_SECRET="MY_SESSION_SECRET"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google reCAPTCHA v3 keys (get from https://www.google.com/recaptcha/admin/create)
# VITE_RECAPTCHA_SITE_KEY is public (embedded at build time); RECAPTCHA_SECRET_KEY must remain private on the server.
VITE_RECAPTCHA_SITE_KEY="MY_RECAPTCHA_SITE_KEY"
RECAPTCHA_SECRET_KEY="MY_RECAPTCHA_SECRET_KEY"
